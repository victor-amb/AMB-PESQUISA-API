APP_NAME="AMB Pesquisas"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo

# URL DESTE PROETO QUE ESTA RODANDO (API)
APP_URL=http://amb-pesquisa.test

# URL DO PROJETO ADMINISTRATIVO (FRONTEND)
ADMIN_URL=http://localhost:8011/

#  URL DO PROETO DE RESPOSTA (FRONTEND)
RESPONDER_URL=http://localhost:8012/

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=amb_pesquisas
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="pesquisas@amb.org.br"
MAIL_FROM_NAME="AMB Pesquisas"

# Configurações do Gateway de Disparo de WhatsApp - 
# TODO: Débito técnico - Tem que implementar um sistema de envio de mensagens via WhatsApp, mas ainda não foi feito. Por enquanto, o envio de mensagens é feito via e-mail.
WHATSAPP_API_URL="https://api.seu-provedor.com.br/v1"
WHATSAPP_API_TOKEN="seu_token_secreto_aqui"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
